{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-chat",
  "description": "Only chat ingestion from the selected chat-only HTTPS page; Rust verifies actual URL/session",
  "local": false,
  "windows": ["source-youtube", "source-twitch"],
  "remote": {
    "urls": ["https://www.youtube.com/live_chat?*", "https://www.twitch.tv/popout/*/chat?*"]
  },
  "permissions": ["allow-chat-ingest"]
}
